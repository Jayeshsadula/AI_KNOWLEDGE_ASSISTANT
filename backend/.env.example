# ── Firebase Admin SDK ─────────────────────────────────────────────────────
# Option A: individual environment variables (preferred for cloud deployments)


# Option B: path to service account JSON file (preferred for local development)
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# ── CORS ───────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── MongoDB (used in later modules) ────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=ai_knowledge_assistant

# ── ChromaDB (used in later modules) ───────────────────────────────────────
CHROMA_PERSIST_PATH=./chroma_db

# ── Ollama (used in later modules) ─────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
